HTTP_ADDRESS=:8080
SHUTDOWN_TIMEOUT=10s
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway?sslmode=disable
# Generate independent random secrets, each at least 32 characters.
API_KEY=
WEBHOOK_SECRET=
WEBHOOK_ALLOWED_ORIGINS=https://your-website.example
SHOPEE_SESSION_FILE=session.json
SHOPEE_QRIS_FILE=qris.txt
SHOPEE_MERCHANT_ID=
SHOPEE_STORE_ID=
PAYMENT_EXPIRY=15m
UNIQUE_CODE_MIN=1
UNIQUE_CODE_MAX=999
POLL_INTERVAL=5s
SHOPEE_MAX_PAGES=100

# Optional Telegram bot for Shopee login and session renewal.
# Setting TELEGRAM_BOT_TOKEN enables it; TELEGRAM_ADMIN_IDS is then required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Skip the phone/password prompts during /login (optional).
# SHOPEE_LOGIN_PHONE=
# SHOPEE_LOGIN_PASSWORD=
# SESSION_REFRESH_BEFORE=2h
# SESSION_CHECK_INTERVAL=1m

# Production compose (compose.prod.yaml) only.
# DATABASE_URL, HTTP_ADDRESS and SHOPEE_*_FILE are set by the compose file.
POSTGRES_PASSWORD=
# IMAGE_TAG=latest
# SECRETS_DIR=./secrets
# API_BIND=127.0.0.1
# API_PORT=8080
